generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Farm {
  id        Int      @id @default(1)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  animals Animal[]

  @@map("farm")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  READER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  identification     String     @unique @db.VarChar(50)
  fullName           String     @map("full_name") @db.VarChar(150)
  email              String     @db.VarChar(254)
  phone              String?    @db.VarChar(30)
  address            String?    @db.VarChar(250)
  passwordHash       String     @map("password_hash") @db.Text
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?
  role               UserRole   @default(READER)
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  animalsCreated Animal[]          @relation("AnimalsCreated")
  animalsUpdated Animal[]          @relation("AnimalsUpdated")
  animalChanges  AnimalChangeLog[] @relation("AnimalChanges")

  @@map("app_user")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_session")
}

enum AnimalSex {
  FEMALE
  MALE
  UNKNOWN

  @@map("animal_sex")
}

enum AnimalStatus {
  ALIVE
  DEAD
  SOLD
  SICK
  TRANSFERRED

  @@map("animal_status")
}

model Species {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  animals Animal[]
  breeds  Breed[]

  @@map("species")
}

model Breed {
  id        Int      @id @default(autoincrement())
  speciesId Int      @map("species_id")
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  species Species  @relation(fields: [speciesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  animals Animal[]

  @@unique([speciesId, name])
  @@index([speciesId])
  @@map("breed")
}

model Animal {
  id     String  @id @default(uuid()) @db.Uuid
  farmId Int     @map("farm_id")
  code   String  @unique @db.VarChar(50)
  name   String? @db.VarChar(150)

  speciesId Int  @map("species_id")
  breedId   Int? @map("breed_id")

  sex       AnimalSex @default(UNKNOWN)
  birthDate DateTime? @map("birth_date") @db.Date
  weightKg  Decimal?  @map("weight_kg") @db.Decimal(10, 2)

  motherId String? @map("mother_id") @db.Uuid
  fatherId String? @map("father_id") @db.Uuid

  status   AnimalStatus @default(ALIVE)
  isActive Boolean      @default(true) @map("is_active")

  createdById String  @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  breed   Breed?  @relation(fields: [breedId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  mother Animal? @relation("AnimalMother", fields: [motherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  father Animal? @relation("AnimalFather", fields: [fatherId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  motherOf Animal[] @relation("AnimalMother")
  fatherOf Animal[] @relation("AnimalFather")

  createdBy User  @relation("AnimalsCreated", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy User? @relation("AnimalsUpdated", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  changeLogs AnimalChangeLog[]

  @@index([farmId, status])
  @@index([speciesId])
  @@index([breedId])
  @@index([motherId])
  @@index([fatherId])
  @@map("animal")
}

enum AnimalChangeAction {
  CREATED
  UPDATED
  DEACTIVATED

  @@map("animal_change_action")
}

model AnimalChangeLog {
  id           String             @id @default(uuid()) @db.Uuid
  animalId     String             @map("animal_id") @db.Uuid
  action       AnimalChangeAction @map("action")
  changedById  String             @map("changed_by_id") @db.Uuid
  previousData Json?              @map("previous_data")
  newData      Json?              @map("new_data")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy User   @relation("AnimalChanges", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([animalId, createdAt])
  @@index([changedById])
  @@map("animal_change_log")
}
