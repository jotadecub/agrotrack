# Copiar este archivo como .env y completar la contraseña local.
# La contraseña debe estar codificada para utilizarse en una URL.
DATABASE_URL="postgresql://agrotrack_dev:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/agrotrack_dev?schema=public"

# Generar localmente 32 bytes aleatorios representados como 64 caracteres hexadecimales.
AUTH_JWT_SECRET="REPLACE_WITH_64_HEXADECIMAL_CHARACTERS"

# Para pruebas locales: copiar esta variable a .env.test y completar.
TEST_DATABASE_URL="postgresql://agrotrack_test:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/agrotrack_test?schema=public"