{
  "name": "agrotrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:check": "node --conditions=react-server --import tsx scripts/check-database.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:installation": "node --conditions=react-server --import tsx scripts/setup-installation.ts",
    "db:test:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "db:test:status": "prisma migrate status --config prisma.test.config.ts",
    "test:integration": "set VITE_CONFIG_NATIVE_IGNORE_WARNING=true&& vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "18.0.9",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
